   "id": "b0",
   "fx": "hook",
   "say": "最強とよばれた騎馬隊が、柵の前で止まった戦いがあるのだ。",
   "yomi": "さいきょうとよばれたきばたいが、さくのまえでとまった、たたかいがあるのだ。",
   "cap": [
    "最強の騎馬隊が",
    "柵の前で止まった"
   ]
  },
  {
   "id": "b1",
   "fx": "setup",
   "say": "1575年、長篠の設楽原。織田・徳川軍は約3万8千、武田軍は約1万5千なのだ。",
   "yomi": "せんごひゃくななじゅうごねん、ながしののしたらがはら。おだ、とくがわぐんわやくさんまんはっせん、たけだぐんわやくいちまんごせんなのだ。",
   "cap": [
    "1575年 長篠・設楽原",
    "約3万8千 対 約1万5千"
   ]
  },
  {
   "id": "b2",
   "fx": "fence",
   "say": "織田・徳川軍は、小川の後ろに、長さ約2キロの柵を作ったのだ。",
   "yomi": "おだ、とくがわぐんわ、おがわのうしろに、ながさやくにキロのさくをつくったのだ。",
   "cap": [
    "小川の後ろに",
    "長さ約2kmの柵"
   ]
  },
  {
   "id": "b3",
   "fx": "guns",
   "say": "柵の後ろには、たくさんの鉄砲。数は千とも三千ともいわれるのだ。",
   "yomi": "さくのうしろにわ、たくさんのてっぽう。かずわせんとも、さんぜんともいわれるのだ。",
   "cap": [
    "柵の後ろに鉄砲",
    "千とも三千とも"
   ]
  },
  {
   "id": "b4",
   "fx": "charge",
   "say": "武田軍は、柵に向かって何度も攻めかかったのだ。",
   "yomi": "たけだぐんわ、さくにむかって、なんどもせめかかったのだ。",
   "cap": [
    "武田軍が",
    "何度も攻めかかる"
   ]
  },
  {
   "id": "b5",
   "fx": "fire",
   "say": "柵で足が止まったところに、鉄砲が撃ちこまれたのだ。",
   "yomi": "さくであしがとまったところに、てっぽうがうちこまれたのだ。",
   "cap": [
    "柵で止まったところに",
    "鉄砲が撃ちこまれる"
   ]
  },
  {
   "id": "b6",
   "fx": "sandan",
   "say": "有名な三段撃ちは、本当にあったのか、今も議論があるのだ。",
   "yomi": "ゆうめいなさんだんうちわ、ほんとうにあったのか、いまもぎろんがあるのだ。",
   "cap": [
    "有名な「三段撃ち」は",
    "今も議論がある"
   ]
  },
  {
   "id": "b7",
   "fx": "result",
   "say": "武田軍は大きくくずれ、名のある武将が何人も討ち死にしたのだ。",
   "yomi": "たけだぐんわおおきくくずれ、なのあるぶしょうが、なんにんもうちじにしたのだ。",
   "cap": [
    "武田軍は崩れ",
    "名のある武将が討ち死に"
   ]
  },
  {
   "id": "b8",
