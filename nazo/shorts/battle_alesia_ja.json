 ],
 "lines": [
  {
   "id": "b0",
   "fx": "hook",
   "say": "この城の周り、なんで壁が2重なのだ？",
   "yomi": "このしろのまわり、なんでかべがにじゅうなのだ？",
   "cap": [
    "城の周りに",
    "なんで壁が2重？"
   ]
  },
  {
   "id": "b1",
   "fx": "setup",
   "say": "紀元前52年、ガリアのアレシア。カエサルのローマ軍が、この町を囲んだのだ。",
   "yomi": "きげんぜんごじゅうにねん、ガリアのアレシア。カエサルのローマぐんが、このまちをかこんだのだ。",
   "cap": [
    "紀元前52年 アレシア",
    "カエサルが町を囲む"
   ]
  },
  {
   "id": "b2",
   "fx": "inside",
   "say": "町の中には、カエサルの記録で、8万人のガリア兵がいたのだ。",
   "yomi": "まちのなかにわ、カエサルのきろくで、はちまんにんのガリアへいがいたのだ。",
   "cap": [
    "町の中にガリア兵",
    "カエサルの記録で8万人"
   ]
  },
  {
   "id": "b3",
   "fx": "wall1",
   "say": "まず、町をぐるりと囲む、内側の壁を作ったのだ。長さは約18キロなのだ。",
   "yomi": "まず、まちをぐるりとかこむ、うちがわのかべをつくったのだ。ながさわやくじゅうはっキロなのだ。",
   "cap": [
    "まず内側の壁",
    "長さ 約18キロ"
   ]
  },
  {
   "id": "b4",
   "fx": "relief",
   "say": "ところが、外から、助けのガリア軍がやってくるのだ。",
   "yomi": "ところが、そとから、たすけのガリアぐんがやってくるのだ。",
   "cap": [
    "ところが外から",
    "助けの大軍がくる"
   ]
  },
  {
   "id": "b5",
   "fx": "relief2",
   "say": "その数は、カエサルの記録で、24万8千人なのだ。",
   "yomi": "そのかずわ、カエサルのきろくで、にじゅうよんまんはっせんにんなのだ。",
   "cap": [
    "カエサルの記録で",
    "24万8千人"
   ]
  },
  {
   "id": "b6",
   "fx": "wall2",
   "say": "そこでカエサルは、外向きにも、約21キロの壁を作ったのだ。",
   "yomi": "そこでカエサルわ、そとむきにも、やくにじゅういっキロのかべをつくったのだ。",
   "cap": [
    "外向きにも壁",
    "長さ 約21キロ"
   ]
  },
  {
   "id": "b7",
   "fx": "both",
   "say": "ローマ軍は、2つの壁のあいだで、内と外の両方と戦ったのだ。",
   "yomi": "ローマぐんわ、ふたつのかべのあいだで、うちとそとのりょうほうとたたかったのだ。",
   "cap": [
    "2つの壁のあいだで",
    "内と外の両方と戦う"
   ]
  },
  {
   "id": "b8",
   "fx": "result",
   "say": "外の大軍は押し返されて、町のガリア軍は降伏したのだ。",
   "yomi": "そとのたいぐんわおしかえされて、まちのガリアぐんわこうふくしたのだ。",
   "cap": [
    "外の大軍は押し返され",
    "町のガリア軍は降伏"
   ]
  },
  {
   "id": "b9",
   "fx": "end",
   "say": "だから壁は2重。中を閉じこめて、外から守るためなのだ。",
   "yomi": "だからかべわにじゅう。なかをとじこめて、そとからまもるためなのだ。",
   "cap": [
    "中を閉じこめて",
    "外から守る2重の壁"
   ]
  }
 ]
