   ]
  },
  {
   "id": "b2",
   "fx": "narrow",
   "say": "ここは、片側が崖、片側が海。通れる道は、幅15メートルほどなのだ。",
   "yomi": "ここわ、かたがわががけ、かたがわがうみ。とおれるみちわ、はばじゅうごメートルほどなのだ。",
   "cap": [
    "片側は崖 片側は海",
    "道の幅は約15m"
   ]
  },
  {
   "id": "b3",
   "fx": "hold",
   "say": "せまい道では、大軍でも、一度に戦えるのは前の少しだけなのだ。",
   "yomi": "せまいみちでわ、たいぐんでも、いちどにたたかえるのわ、まえのすこしだけなのだ。",
   "cap": [
    "せまい道では",
    "前の少しだけが戦える"
   ]
  },
  {
   "id": "b4",
   "fx": "days",
   "say": "スパルタ王レオニダスたちは、ここで2日間、押し返し続けたのだ。",
   "yomi": "スパルタおうレオニダスたちわ、ここでふつかかん、おしかえしつづけたのだ。",
   "cap": [
    "レオニダスたちは",
    "2日間押し返した"
   ]
  },
  {
   "id": "b5",
   "fx": "path",
   "say": "ところが、地元の男が、山の裏道をペルシャ軍に教えたのだ。",
   "yomi": "ところが、じもとのおとこが、やまのうらみちをペルシャぐんにおしえたのだ。",
   "cap": [
    "ところが",
    "山の裏道が知られた"
   ]
  },
  {
   "id": "b6",
   "fx": "behind",
   "say": "裏道を回った兵が、ギリシャ軍の後ろに出てくるのだ。",
   "yomi": "うらみちをまわったへいが、ギリシャぐんのうしろにでてくるのだ。",
   "cap": [
    "裏道を回って",
    "後ろに出てくる"
   ]
  },
  {
   "id": "b7",
   "fx": "stand",
   "say": "3日目、レオニダスは約1100人で残り、最後まで戦ったのだ。",
   "yomi": "みっかめ、レオニダスわやくせんひゃくにんでのこり、さいごまでたたかったのだ。",
   "cap": [
    "3日目",
    "約1100人が残って戦う"
   ]
  },
  {
   "id": "b8",
   "fx": "end",
   "say": "せまい道なら、少ない兵でも大軍を止められる。それを見せた戦いなのだ。",
   "yomi": "せまいみちなら、すくないへいでもたいぐんをとめられる。それをみせたたたかいなのだ。",
   "cap": [
    "せまい道なら",
    "少数でも大軍を止められる"
   ]
