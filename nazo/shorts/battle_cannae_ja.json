  "ショート"
 ],
 "lines": [
  {
   "id": "b0",
   "fx": "hook",
   "say": "兵の数が半分なのに、8万人のローマ軍をぐるりと囲んだ作戦があるのだ。",
   "yomi": "へいのかずがはんぶんなのに、はちまんにんのローマぐんを、ぐるりとかこんだ、さくせんがあるのだ。",
   "cap": [
    "兵の数は半分なのに",
    "8万人をぐるりと囲んだ"
   ]
  },
  {
   "id": "b1",
   "fx": "setup",
   "say": "紀元前216年、イタリアのカンナエ。ローマ軍は約8万、ハンニバルの軍は約5万なのだ。",
   "yomi": "きげんぜんにひゃくじゅうろくねん、イタリアのカンナエ。ローマぐんわやくはちまん、ハンニバルのぐんわやくごまんなのだ。",
   "cap": [
    "紀元前216年 カンナエの戦い",
    "ローマ約8万 vs 約5万"
   ]
  },
  {
   "id": "b2",
   "fx": "rome",
   "say": "ローマ軍は、真ん中に歩兵をぎっしり、深く並べたのだ。",
   "yomi": "ローマぐんわ、まんなかにほへいをぎっしり、ふかくならべたのだ。",
   "cap": [
    "ローマ軍",
    "真ん中に歩兵をぎっしり"
   ]
  },
  {
   "id": "b3",
   "fx": "han",
   "say": "ハンニバルは、真ん中を前にふくらませた、三日月の形に並べたのだ。",
   "yomi": "ハンニバルわ、まんなかをまえにふくらませた、みかづきのかたちにならべたのだ。",
   "cap": [
    "ハンニバルは",
    "三日月の形に並べた"
   ]
  },
  {
   "id": "b4",
   "fx": "cav",
   "say": "まず、両はしの騎兵が、ローマの騎兵を追いはらうのだ。",
   "yomi": "まず、りょうはしのきへいが、ローマのきへいをおいはらうのだ。",
   "cap": [
    "まず両はしの騎兵が",
    "ローマの騎兵を追いはらう"
   ]
  },
  {
   "id": "b5",
   "fx": "push",
   "say": "ローマの歩兵が真ん中を押すと、三日月は少しずつ下がっていくのだ。",
   "yomi": "ローマのほへいがまんなかをおすと、みかづきわすこしずつさがっていくのだ。",
   "cap": [
    "真ん中を押されると",
    "少しずつ下がる"
   ]
  },
  {
   "id": "b6",
   "fx": "flank",
   "say": "すると、横にいたアフリカの兵が、内側へ向きを変えるのだ。",
   "yomi": "すると、よこにいたアフリカのへいが、うちがわへむきをかえるのだ。",
   "cap": [
    "横にいた兵が",
    "内側へ向きを変える"
   ]
  },
  {
   "id": "b7",
   "fx": "rear",
   "say": "騎兵は、ローマ軍の後ろに回りこんで、ふたをするのだ。",
   "yomi": "きへいわ、ローマぐんのうしろにまわりこんで、ふたをするのだ。",
   "cap": [
    "騎兵が後ろに回って",
    "ふたをする"
   ]
  },
  {
   "id": "b8",
   "fx": "ring",
   "say": "これで、ローマ軍は、ぐるりと囲まれたのだ。",
   "yomi": "これで、ローマぐんわ、ぐるりとかこまれたのだ。",
   "cap": [
    "これで",
    "ぐるりと囲まれた"
   ]
  },
  {
   "id": "b9",
   "fx": "loss",
   "say": "ローマ軍の死者は、5万5千人とも、7万人とも言われるのだ。",
   "yomi": "ローマぐんのししゃわ、ごまんごせんにんとも、ななまんにんともいわれるのだ。",
   "cap": [
    "ローマ軍の死者",
    "5万5千人〜7万人"
   ]
  },
  {
   "id": "b10",
   "fx": "end",
   "say": "両側から包みこむ戦い方の、お手本と言われているのだ。",
   "yomi": "りょうがわからつつみこむたたかいかたの、おてほんといわれているのだ。",
   "cap": [
    "両側から包みこむ",
    "戦い方のお手本"
   ]
  }
 ]
