 ],
 "lines": [
  {
   "id": "b0",
   "fx": "hook",
   "say": "消費税は、もともと何のために作られたのか、知ってるのだ？",
   "yomi": "しょうひぜいわ、もともとなんのためにつくられたのか、しってるのだ？",
   "cap": [
    "消費税は",
    "何のためにできた？"
   ]
  },
  {
   "id": "b1",
   "fx": "y1989",
   "say": "消費税が始まったのは、1989年。税率は3パーセントだったのだ。",
   "yomi": "しょうひぜいがはじまったのわ、せんきゅうひゃくはちじゅうきゅうねん。ぜいりつわ、さんパーセントだったのだ。",
   "cap": [
    "1989年に始まった",
    "税率は3%"
   ]
  },
  {
   "id": "b2",
   "fx": "direct",
   "say": "それまでの国の税は、給料などの所得にかかる税が中心で、買い物にかかる税は、一部の品物だけだったのだ。",
   "yomi": "それまでのくにのぜいわ、きゅうりょうなどのしょとくにかかるぜいがちゅうしんで、かいものにかかるぜいわ、いちぶのしなものだけだったのだ。",
   "cap": [
    "それまでは",
    "所得にかかる税が中心"
   ]
  },
  {
   "id": "b3",
   "fx": "aging",
   "say": "でも、高齢化が進むと、働く世代の税だけで支えるのは、大変になると考えられたのだ。",
   "yomi": "でも、こうれいかがすすむと、はたらくせだいのぜいだけでささえるのわ、たいへんになると、かんがえられたのだ。",
   "cap": [
    "高齢化が進むと",
    "働く世代だけでは大変"
   ]
  },
  {
   "id": "b4",
   "fx": "broad",
   "say": "そこで、ほぼすべての買い物に、広く少しずつかかる税が作られたのだ。",
   "yomi": "そこで、ほぼすべてのかいものに、ひろくすこしずつかかるぜいがつくられたのだ。",
   "cap": [
    "ほぼすべての買い物に",
    "広く少しずつ"
   ]
  },
  {
   "id": "b5",
   "fx": "fails",
   "say": "実はその前に、似た税の案が、2回もつぶれているのだ。",
   "yomi": "じつわそのまえに、にたぜいのあんが、にかいもつぶれているのだ。",
   "cap": [
    "実はその前に",
    "似た案が2回つぶれた"
   ]
  },
  {
   "id": "b6",
   "fx": "up",
   "say": "そのあと、1997年に5パーセント、2014年に8パーセント、2019年に10パーセントになったのだ。",
   "yomi": "そのあと、せんきゅうひゃくきゅうじゅうななねんにごパーセント、にせんじゅうよねんにはちパーセント、にせんじゅうきゅうねんにじゅっパーセントになったのだ。",
   "cap": [
    "5% → 8% → 10%",
    "1997年・2014年・2019年"
   ]
  },
  {
   "id": "b7",
   "fx": "use",
   "say": "国の説明では、引き上げで増えた分は、すべて年金や医療、介護、子育てなどに使うことになっているのだ。",
   "yomi": "くにのせつめいでわ、ひきあげでふえたぶんわ、すべてねんきんやいりょう、かいご、こそだてなどに、つかうことになっているのだ。",
   "cap": [
    "国の説明では",
    "増えた分は社会保障に"
   ]
  },
  {
   "id": "b8",
   "fx": "food",
   "say": "2019年からは、食べ物などは8パーセントのまま。これを軽減税率というのだ。",
   "yomi": "にせんじゅうきゅうねんからわ、たべものなどわ、はちパーセントのまま。これを、けいげんぜいりつというのだ。",
   "cap": [
    "食べ物などは8%のまま",
    "軽減税率"
   ]
  },
  {
   "id": "b9",
   "fx": "debate",
   "say": "ただ、収入が少ない人ほど、負担が重くなりやすい、という批判もあって、今も議論が続いているのだ。",
   "yomi": "ただ、しゅうにゅうがすくないひとほど、ふたんがおもくなりやすい、というひはんもあって、いまもぎろんがつづいているのだ。",
   "cap": [
    "収入が少ない人ほど負担が重い",
    "という批判もある"
   ]
  },
  {
   "id": "b10",
   "fx": "end",
   "say": "みんなで広く支えるために作られた税。それが消費税のはじまりなのだ。",
   "yomi": "みんなでひろくささえるためにつくられたぜい。それが、しょうひぜいのはじまりなのだ。",
   "cap": [
    "みんなで広く支える",
    "それが消費税のはじまり"
   ]
  }
 ]
}