 "lines": [
  {
   "id": "b0",
   "fx": "hook",
   "say": "2万の大軍の大将が、数千もいない兵に討たれた戦いがあるのだ。",
   "yomi": "にまんのたいぐんのたいしょうが、すうせんもいないへいに、うたれたたたかいがあるのだ。",
   "cap": [
    "2万の大軍の大将が",
    "数千の兵に討たれた"
   ]
  },
  {
   "id": "b1",
   "fx": "setup",
   "say": "1560年、尾張の桶狭間。今川義元の軍は2万前後、織田信長の軍は数千もなかったのだ。",
   "yomi": "せんごひゃくろくじゅうねん、おわりのおけはざま。いまがわよしもとのぐんわにまんぜんご、おだのぶながのぐんわ、すうせんもなかったのだ。",
   "cap": [
    "1560年 桶狭間",
    "2万前後 対 数千"
   ]
  },
  {
   "id": "b2",
   "fx": "spread",
   "say": "今川軍は、先に織田の砦を攻めて、兵があちこちに分かれていたのだ。",
   "yomi": "いまがわぐんわ、さきにおだのとりでをせめて、へいがあちこちにわかれていたのだ。",
   "cap": [
    "今川軍は砦を攻めて",
    "兵が分かれていた"
   ]
  },
  {
   "id": "b3",
   "fx": "rest",
   "say": "義元の本隊は、山あいで休んでいたのだ。",
   "yomi": "よしもとのほんたいわ、やまあいでやすんでいたのだ。",
   "cap": [
    "義元の本隊は",
    "山あいで休む"
   ]
  },
  {
   "id": "b4",
   "fx": "move",
   "say": "信長は約2千の兵を集めて、本隊の近くへ進んだのだ。",
   "yomi": "のぶながわやくにせんのへいをあつめて、ほんたいのちかくへすすんだのだ。",
   "cap": [
    "信長は約2千で",
    "本隊の近くへ"
   ]
  },
  {
   "id": "b5",
   "fx": "rain",
   "say": "そのとき、激しいにわか雨。織田軍の動きは、今川軍から見えなかったのだ。",
   "yomi": "そのとき、はげしいにわかあめ。おだぐんのうごきわ、いまがわぐんからみえなかったのだ。",
   "cap": [
    "激しいにわか雨",
    "今川軍から見えない"
   ]
  },
  {
   "id": "b6",
   "fx": "attack",
   "say": "雨が上がった直後、織田軍は本隊に攻めかかったのだ。",
   "yomi": "あめがあがったちょくご、おだぐんわほんたいにせめかかったのだ。",
   "cap": [
    "雨が上がった直後",
    "本隊に攻めかかる"
   ]
  },
  {
   "id": "b7",
   "fx": "result",
   "say": "義元は討たれ、今川軍は総くずれになったのだ。",
   "yomi": "よしもとわうたれ、いまがわぐんわそうくずれになったのだ。",
   "cap": [
    "義元が討たれ",
    "今川軍は総崩れ"
   ]
  },
  {
   "id": "b8",
   "fx": "debate",
   "say": "ただ、奇襲だったのか、正面から攻めたのかは、今も議論があるのだ。",
   "yomi": "ただ、きしゅうだったのか、しょうめんからせめたのかわ、いまもぎろんがあるのだ。",
   "cap": [
    "奇襲か 正面からか",
    "今も議論がある"
   ]
  },
  {
   "id": "b9",
   "fx": "end",
   "say": "数で負けても、大将をねらえば、ひっくり返ることがある。それを見せた戦いなのだ。",
   "yomi": "かずでまけても、たいしょうをねらえば、ひっくりかえることがある。それをみせたたたかいなのだ。",
   "cap": [
    "数で負けても",
    "大将をねらえば"
   ]
  }
 ]
