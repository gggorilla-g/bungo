 "lines": [
  {
   "id": "b0",
   "fx": "hook",
   "say": "山の上から囲んで待っていた軍が、数時間で負けた戦いがあるのだ。",
   "yomi": "やまのうえからかこんでまっていたぐんが、すうじかんでまけた、たたかいがあるのだ。",
   "cap": [
    "囲んで待っていた軍が",
    "数時間で負けた"
   ]
  },
  {
   "id": "b1",
   "fx": "setup",
   "say": "1600年、関ヶ原。徳川家康の東軍と、石田三成たちの西軍がぶつかったのだ。",
   "yomi": "せんろっぴゃくねん、せきがはら。とくがわいえやすのとうぐんと、いしだみつなりたちのせいぐんが、ぶつかったのだ。",
   "cap": [
    "1600年 関ヶ原",
    "東軍 対 西軍"
   ]
  },
  {
   "id": "b2",
   "fx": "surround",
   "say": "西軍は約8万ともいわれ、まわりの山に陣をしいて、東軍を囲む形だったのだ。",
   "yomi": "せいぐんわやくはちまんともいわれ、まわりのやまにじんをしいて、とうぐんをかこむかたちだったのだ。",
   "cap": [
    "西軍は山に陣をしき",
    "東軍を囲む形"
   ]
  },
  {
   "id": "b3",
   "fx": "fight",
   "say": "朝、霧の中で戦いが始まり、宇喜多隊などがよく戦ったのだ。",
   "yomi": "あさ、きりのなかでたたかいがはじまり、うきたたいなどが、よくたたかったのだ。",
   "cap": [
    "朝 霧の中で開戦",
    "宇喜多隊がよく戦う"
   ]
  },
  {
   "id": "b4",
   "fx": "watch",
   "say": "でも、南宮山の毛利軍は動かず、西軍で本当に戦ったのは半分以下だったのだ。",
   "yomi": "でも、なんぐうさんのもうりぐんわうごかず、せいぐんでほんとうにたたかったのわ、はんぶんいかだったのだ。",
   "cap": [
    "南宮山の毛利軍は動かず",
    "戦ったのは半分以下"
   ]
  },
  {
   "id": "b5",
   "fx": "matsuo",
   "say": "そして、松尾山には、小早川秀秋の約1万5千がいたのだ。",
   "yomi": "そして、まつおやまにわ、こばやかわひであきの、やくいちまんごせんがいたのだ。",
   "cap": [
    "松尾山には",
    "小早川隊 約1万5千"
   ]
  },
  {
   "id": "b6",
   "fx": "turn",
   "say": "小早川隊は山をかけ下り、味方のはずの大谷隊に攻めかかったのだ。",
   "yomi": "こばやかわたいわやまをかけおり、みかたのはずのおおたにたいに、せめかかったのだ。",
   "cap": [
    "小早川隊が山を下り",
    "味方の大谷隊を攻める"
   ]
  },
  {
   "id": "b7",
   "fx": "chain",
   "say": "ほかの隊も次々に寝返り、大谷隊はくずれ、西軍は総くずれになったのだ。",
   "yomi": "ほかのたいもつぎつぎにねがえり、おおたにたいわくずれ、せいぐんわそうくずれになったのだ。",
   "cap": [
    "ほかの隊も寝返り",
    "西軍は総崩れ"
   ]
  },
  {
   "id": "b8",
   "fx": "end",
   "say": "囲む形でも、味方が動かなければ囲みにならない。それを見せた戦いなのだ。",
   "yomi": "かこむかたちでも、みかたがうごかなければ、かこみにならない。それをみせたたたかいなのだ。",
   "cap": [
    "囲む形でも",
    "動かなければ囲めない"
   ]
  }
 ]
}