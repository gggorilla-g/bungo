 "lines": [
  {
   "id": "b0",
   "cap": [
    "兵の数は半分なのに",
    "8万人をぐるりと囲んだ"
   ],
   "fx": "hook",
   "text": "兵の数が半分なのに、8万人のローマ軍をぐるりと囲んだ作戦があるのだ。"
  },
  {
   "id": "b1",
   "cap": [
    "紀元前216年 カンナエの戦い",
    "ローマ約8万 vs 約5万"
   ],
   "fx": "setup",
   "text": "紀元前216年、イタリアのカンナエ。ローマ軍は約8万、ハンニバルの軍は約5万なのだ。"
  },
  {
   "id": "b2",
   "cap": [
    "ローマ軍",
    "真ん中に歩兵をぎっしり"
   ],
   "fx": "rome",
   "text": "ローマ軍は、真ん中に歩兵をぎっしり、深く並べたのだ。"
  },
  {
   "id": "b3",
   "cap": [
    "ハンニバルは",
    "三日月の形に並べた"
   ],
   "fx": "han",
   "text": "ハンニバルは、真ん中を前にふくらませた、三日月の形に並べたのだ。"
  },
  {
   "id": "b4",
   "cap": [
    "まず両はしの騎兵が",
    "ローマの騎兵を追いはらう"
   ],
   "fx": "cav",
   "text": "まず、両はしの騎兵が、ローマの騎兵を追いはらうのだ。"
  },
  {
   "id": "b5",
   "cap": [
    "真ん中を押されると",
    "少しずつ下がる"
   ],
   "fx": "push",
   "text": "ローマの歩兵が真ん中を押すと、三日月は少しずつ下がっていくのだ。"
  },
  {
   "id": "b6",
   "cap": [
    "横にいた兵が",
    "内側へ向きを変える"
   ],
   "fx": "flank",
   "text": "すると、横にいたアフリカの兵が、内側へ向きを変えるのだ。"
  },
  {
   "id": "b7",
   "cap": [
    "騎兵が後ろに回って",
    "ふたをする"
   ],
   "fx": "rear",
   "text": "騎兵は、ローマ軍の後ろに回りこんで、ふたをするのだ。"
  },
  {
   "id": "b8",
   "cap": [
    "これで",
    "ぐるりと囲まれた"
   ],
   "fx": "ring",
   "text": "これで、ローマ軍は、ぐるりと囲まれたのだ。"
  },
  {
   "id": "b9",
   "cap": [
    "ローマ軍の死者",
    "5万5千人〜7万人"
   ],
   "fx": "loss",
   "text": "ローマ軍の死者は、5万5千人とも、7万人とも言われるのだ。"
  },
  {
   "id": "b10",
   "cap": [
    "両側から包みこむ",
    "戦い方のお手本"
   ],
   "fx": "end",
   "text": "両側から包みこむ戦い方の、お手本と言われているのだ。"
  }
 ]
