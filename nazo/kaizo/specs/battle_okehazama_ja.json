 "lines": [
  {
   "id": "b0",
   "cap": [
    "2万の大軍の大将が",
    "数千の兵に討たれた"
   ],
   "fx": "hook",
   "text": "2万の大軍の大将が、数千もいない兵に討たれた戦いがあるのだ。"
  },
  {
   "id": "b1",
   "cap": [
    "1560年 桶狭間",
    "2万前後 対 数千"
   ],
   "fx": "setup",
   "text": "1560年、尾張の桶狭間。今川義元の軍は2万前後、織田信長の軍は数千もなかったのだ。"
  },
  {
   "id": "b2",
   "cap": [
    "今川軍は砦を攻めて",
    "兵が分かれていた"
   ],
   "fx": "spread",
   "text": "今川軍は、先に織田の砦を攻めて、兵があちこちに分かれていたのだ。"
  },
  {
   "id": "b3",
   "cap": [
    "義元の本隊は",
    "山あいで休む"
   ],
   "fx": "rest",
   "text": "義元の本隊は、山あいで休んでいたのだ。"
  },
  {
   "id": "b4",
   "cap": [
    "信長は約2千で",
    "本隊の近くへ"
   ],
   "fx": "move",
   "text": "信長は約2千の兵を集めて、本隊の近くへ進んだのだ。"
  },
  {
   "id": "b5",
   "cap": [
    "激しいにわか雨",
    "今川軍から見えない"
   ],
   "fx": "rain",
   "text": "そのとき、激しいにわか雨。織田軍の動きは、今川軍から見えなかったのだ。"
  },
  {
   "id": "b6",
   "cap": [
    "雨が上がった直後",
    "本隊に攻めかかる"
   ],
   "fx": "attack",
   "text": "雨が上がった直後、織田軍は本隊に攻めかかったのだ。"
  },
  {
   "id": "b7",
   "cap": [
    "義元が討たれ",
    "今川軍は総崩れ"
   ],
   "fx": "result",
   "text": "義元は討たれ、今川軍は総くずれになったのだ。"
  },
  {
   "id": "b8",
   "cap": [
    "奇襲か 正面からか",
    "今も議論がある"
   ],
   "fx": "debate",
   "text": "ただ、奇襲だったのか、正面から攻めたのかは、今も議論があるのだ。"
  },
  {
   "id": "b9",
   "cap": [
    "数で負けても",
    "大将をねらえば"
   ],
   "fx": "end",
   "text": "数で負けても、大将をねらえば、ひっくり返ることがある。それを見せた戦いなのだ。"
  }
 ]
