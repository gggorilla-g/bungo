 "lines": [
  {
   "id": "b0",
   "cap": [
    "囲んで待っていた軍が",
    "数時間で負けた"
   ],
   "fx": "hook",
   "text": "山の上から囲んで待っていた軍が、数時間で負けた戦いがあるのだ。"
  },
  {
   "id": "b1",
   "cap": [
    "1600年 関ヶ原",
    "東軍 対 西軍"
   ],
   "fx": "setup",
   "text": "1600年、関ヶ原。徳川家康の東軍と、石田三成たちの西軍がぶつかったのだ。"
  },
  {
   "id": "b2",
   "cap": [
    "西軍は山に陣をしき",
    "東軍を囲む形"
   ],
   "fx": "surround",
   "text": "西軍は約8万ともいわれ、まわりの山に陣をしいて、東軍を囲む形だったのだ。"
  },
  {
   "id": "b3",
   "cap": [
    "朝 霧の中で開戦",
    "宇喜多隊がよく戦う"
   ],
   "fx": "fight",
   "text": "朝、霧の中で戦いが始まり、宇喜多隊などがよく戦ったのだ。"
  },
  {
   "id": "b4",
   "cap": [
    "南宮山の毛利軍は動かず",
    "戦ったのは半分以下"
   ],
   "fx": "watch",
   "text": "でも、南宮山の毛利軍は動かず、西軍で本当に戦ったのは半分以下だったのだ。"
  },
  {
   "id": "b5",
   "cap": [
    "松尾山には",
    "小早川隊 約1万5千"
   ],
   "fx": "matsuo",
   "text": "そして、松尾山には、小早川秀秋の約1万5千がいたのだ。"
  },
  {
   "id": "b6",
   "cap": [
    "小早川隊が山を下り",
    "味方の大谷隊を攻める"
   ],
   "fx": "turn",
   "text": "小早川隊は山をかけ下り、味方のはずの大谷隊に攻めかかったのだ。"
  },
  {
   "id": "b7",
   "cap": [
    "ほかの隊も寝返り",
    "西軍は総崩れ"
   ],
   "fx": "chain",
   "text": "ほかの隊も次々に寝返り、大谷隊はくずれ、西軍は総くずれになったのだ。"
  },
  {
   "id": "b8",
   "cap": [
    "囲む形でも",
    "動かなければ囲めない"
   ],
   "fx": "end",
   "text": "囲む形でも、味方が動かなければ囲みにならない。それを見せた戦いなのだ。"
  }
 ]
