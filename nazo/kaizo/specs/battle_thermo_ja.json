 "lines": [
  {
   "id": "b0",
   "cap": [
    "たった約7千人で",
    "大軍を3日止めた"
   ],
   "fx": "hook",
   "text": "たった7千人で、大軍を3日も止めた場所があるのだ。"
  },
  {
   "id": "b1",
   "cap": [
    "紀元前480年 テルモピュライ",
    "ペルシャの大軍がくる"
   ],
   "fx": "setup",
   "text": "紀元前480年、ギリシャのテルモピュライ。ペルシャの大軍が攻めてきたのだ。"
  },
  {
   "id": "b2",
   "cap": [
    "片側は崖 片側は海",
    "道の幅は約15m"
   ],
   "fx": "narrow",
   "text": "ここは、片側が崖、片側が海。通れる道は、幅15メートルほどなのだ。"
  },
  {
   "id": "b3",
   "cap": [
    "せまい道では",
    "前の少しだけが戦える"
   ],
   "fx": "hold",
   "text": "せまい道では、大軍でも、一度に戦えるのは前の少しだけなのだ。"
  },
  {
   "id": "b4",
   "cap": [
    "レオニダスたちは",
    "2日間押し返した"
   ],
   "fx": "days",
   "text": "スパルタ王レオニダスたちは、ここで2日間、押し返し続けたのだ。"
  },
  {
   "id": "b5",
   "cap": [
    "ところが",
    "山の裏道が知られた"
   ],
   "fx": "path",
   "text": "ところが、地元の男が、山の裏道をペルシャ軍に教えたのだ。"
  },
  {
   "id": "b6",
   "cap": [
    "裏道を回って",
    "後ろに出てくる"
   ],
   "fx": "behind",
   "text": "裏道を回った兵が、ギリシャ軍の後ろに出てくるのだ。"
  },
  {
   "id": "b7",
   "cap": [
    "3日目",
    "約1100人が残って戦う"
   ],
   "fx": "stand",
   "text": "3日目、レオニダスは約1100人で残り、最後まで戦ったのだ。"
  },
  {
   "id": "b8",
   "cap": [
    "せまい道なら",
    "少数でも大軍を止められる"
   ],
   "fx": "end",
   "text": "せまい道なら、少ない兵でも大軍を止められる。それを見せた戦いなのだ。"
  }
